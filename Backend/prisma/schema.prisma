  stockTaking      StockTaking @relation(fields: [stockTakingId], references: [id], onDelete: Cascade)

  @@unique([stockTakingId, itemId, locationId])
  @@index([itemId])
  @@index([locationId])
  @@index([countedById])
  @@map("stock_counts")
}

model StockDiscrepancy {
  id               String            @id @default(uuid()) @db.Uuid
  stockTakingId    String            @db.Uuid
  itemId           String            @db.Uuid
  locationId       String            @db.Uuid
  systemQuantity   Decimal           @db.Decimal(14, 3)
  physicalQuantity Decimal           @db.Decimal(14, 3)
  difference       Decimal           @db.Decimal(14, 3)
  reason           String?           @db.VarChar(255)
  investigation    String?           @db.VarChar(1000)
  investigatedById String?           @db.Uuid
  investigatedAt   DateTime?
  status           String            @default("OPEN") @db.VarChar(30)
  stockAdjustments StockAdjustment[]
  investigatedBy   User?             @relation("DiscrepancyInvestigator", fields: [investigatedById], references: [id])
  item             Item              @relation(fields: [itemId], references: [id])
  location         Location          @relation(fields: [locationId], references: [id])
  stockTaking      StockTaking       @relation(fields: [stockTakingId], references: [id], onDelete: Cascade)

  @@unique([stockTakingId, itemId, locationId])
  @@index([stockTakingId])
  @@index([itemId])
  @@index([locationId])
  @@index([status])
  @@map("stock_discrepancies")
}

model StockAdjustment {
  id               String            @id @default(uuid()) @db.Uuid
  adjustmentNumber String            @unique @db.VarChar(50)
  discrepancyId    String?           @db.Uuid
  itemId           String            @db.Uuid
  locationId       String            @db.Uuid
  quantity         Decimal           @db.Decimal(14, 3)
  direction        String            @db.VarChar(20)
  reason           String            @db.VarChar(500)
  status           String            @default("PENDING_APPROVAL") @db.VarChar(30)
  requestedById    String            @db.Uuid
  approvedById     String?           @db.Uuid
  requestedAt      DateTime          @default(now())
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?           @db.VarChar(500)
  approvedBy       User?             @relation("AdjustmentApprover", fields: [approvedById], references: [id])
  discrepancy      StockDiscrepancy? @relation(fields: [discrepancyId], references: [id])
  item             Item              @relation(fields: [itemId], references: [id])
  location         Location          @relation(fields: [locationId], references: [id])
  requestedBy      User              @relation("AdjustmentRequester", fields: [requestedById], references: [id])

  @@index([discrepancyId])
  @@index([itemId])
  @@index([locationId])
  @@index([status])
  @@map("stock_adjustments")
}

model StockBatch {
  id                String    @id @default(uuid()) @db.Uuid
  batchNumber       String    @db.VarChar(100)
  itemId            String    @db.Uuid
  locationId        String    @db.Uuid
  quantity          Decimal   @default(0) @db.Decimal(14, 3)
  manufacturingDate DateTime?
  expiryDate        DateTime?
  status            String    @default("ACTIVE") @db.VarChar(30)
  damaged           Boolean   @default(false)
  obsolete          Boolean   @default(false)
  remarks           String?   @db.VarChar(500)
  item              Item      @relation(fields: [itemId], references: [id])
  location          Location  @relation(fields: [locationId], references: [id])

  @@unique([batchNumber, itemId, locationId])
  @@index([itemId])
  @@index([locationId])
  @@index([expiryDate])
  @@index([status])
  @@index([damaged])
  @@index([obsolete])
  @@map("stock_batches")
}

model DisposalRequest {
  id               String            @id @default(uuid()) @db.Uuid
  requestNumber    String            @unique @db.VarChar(50)
  itemId           String            @db.Uuid
  locationId       String            @db.Uuid
  quantity         Decimal           @db.Decimal(14, 3)
  reason           String            @db.VarChar(500)
  status           String            @default("REQUESTED") @db.VarChar(30)
  requestedById    String            @db.Uuid
  inspectedById    String?           @db.Uuid
  approvedById     String?           @db.Uuid
  inspectionResult String?           @db.VarChar(1000)
  requestedAt      DateTime          @default(now())
  inspectedAt      DateTime?
  approvedAt       DateTime?
  approval         DisposalApproval?
  record           DisposalRecord?
  approvedBy       User?             @relation("DisposalApprover", fields: [approvedById], references: [id])
  inspectedBy      User?             @relation("DisposalInspector", fields: [inspectedById], references: [id])
  item             Item              @relation(fields: [itemId], references: [id])
  location         Location          @relation(fields: [locationId], references: [id])
  requestedBy      User              @relation("DisposalRequester", fields: [requestedById], references: [id])

  @@index([itemId])
  @@index([locationId])
  @@index([status])
  @@map("disposal_requests")
}

model DisposalApproval {
  id                String          @id @default(uuid()) @db.Uuid
  disposalRequestId String          @unique @db.Uuid
  approved          Boolean
  approvedById      String          @db.Uuid
  remarks           String?         @db.VarChar(500)
  approvedAt        DateTime        @default(now())
  approvedBy        User            @relation("DisposalApprovalUser", fields: [approvedById], references: [id])
  disposalRequest   DisposalRequest @relation(fields: [disposalRequestId], references: [id], onDelete: Cascade)

  @@index([approvedById])
  @@map("disposal_approvals")
}

model DisposalRecord {
  id                String          @id @default(uuid()) @db.Uuid
  disposalRequestId String          @unique @db.Uuid
  disposalNumber    String          @unique @db.VarChar(50)
  quantity          Decimal         @db.Decimal(14, 3)
  disposalMethod    String          @db.VarChar(100)
  disposedById      String          @db.Uuid
  disposedAt        DateTime        @default(now())
  remarks           String?         @db.VarChar(500)
  disposalRequest   DisposalRequest @relation(fields: [disposalRequestId], references: [id])
  disposedBy        User            @relation("DisposalRecorder", fields: [disposedById], references: [id])

  @@index([disposedById])
  @@index([disposedAt])
  @@map("disposal_records")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(200)
  message    String           @db.VarChar(1000)
  entityType String?          @db.VarChar(100)
  entityId   String?          @db.Uuid
  isRead     Boolean          @default(false)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

