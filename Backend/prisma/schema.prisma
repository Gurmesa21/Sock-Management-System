generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                @id @default(uuid()) @db.Uuid
  username                    String                @unique @db.VarChar(50)
  email                       String                @unique @db.VarChar(255)
  fullName                    String                @db.VarChar(150)
  phone                       String?               @db.VarChar(30)
  department                  String?               @db.VarChar(150)
  passwordHash                String                @db.VarChar(255)
  isActive                    Boolean               @default(true)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  departmentId                String?               @db.Uuid
  preferences                 Json?                 @default("{}")
  assetAssignments            AssetAssignment[]     @relation("AssetAssignmentUser")
  assetsAssigned              Asset[]               @relation("AssetAssignedUser")
  auditLogs                   AuditLog[]            @relation("AuditActor")
  dispatchSecurity            DispatchRecord[]      @relation("DispatchSecurityOfficer")
  disposalApprovalActions     DisposalApproval[]    @relation("DisposalApprovalUser")
  disposalRecords             DisposalRecord[]      @relation("DisposalRecorder")
  disposalApprovals           DisposalRequest[]     @relation("DisposalApprover")
  disposalInspections         DisposalRequest[]     @relation("DisposalInspector")
  disposalRequests            DisposalRequest[]     @relation("DisposalRequester")
  gatePassesIssued            GatePass[]            @relation("GatePassIssuedTo")
  securityGatePasses          GatePass[]            @relation("GatePassSecurityOfficer")
  goodsReceiptsReceived       GoodsReceipt[]        @relation("GoodsReceiptReceivedBy")
  goodsReceiptsVerified       GoodsReceipt[]        @relation("GoodsReceiptVerifiedBy")
  grnsCreated                 GRN[]                 @relation("GRNCreatedBy")
  inspectionsApproved         Inspection[]          @relation("InspectionApprovedBy")
  inspectionsPerformed        Inspection[]          @relation("InspectionInspector")
  issueVouchersReceived       IssueVoucher[]        @relation("IssueVoucherRecipient")
  returnApprovals             MaterialReturn[]      @relation("ReturnApprover")
  returnInspections           MaterialReturn[]      @relation("ReturnInspector")
  returnRequests              MaterialReturn[]      @relation("ReturnRequester")
  notifications               Notification[]
  resetTokens                 PasswordResetToken[]
  purchaseOrdersCreated       PurchaseOrder[]       @relation("PurchaseOrderCreator")
  requisitionsApproved        PurchaseRequisition[] @relation("RequisitionApprover")
  requisitionsRequested       PurchaseRequisition[] @relation("RequisitionRequester")
  requisitionApprovals        RequisitionApproval[] @relation("RequisitionApprover")
  sessions                    Session[]
  adjustmentsApproved         StockAdjustment[]     @relation("AdjustmentApprover")
  adjustmentsRequested        StockAdjustment[]     @relation("AdjustmentRequester")
  stockCounts                 StockCount[]          @relation("StockCountUser")
  discrepancyInvestigations   StockDiscrepancy[]    @relation("DiscrepancyInvestigator")
  stockTakingsStarted         StockTaking[]         @relation("StockTakingStartedBy")
  stockTransactions           StockTransaction[]
  approvedTransfers           StockTransfer[]       @relation("TransferApprover")
  requestedTransfers          StockTransfer[]       @relation("TransferRequester")
  storeIssuesIssued           StoreIssue[]          @relation("StoreIssueIssuer")
  storeRequisitionsRequested  StoreRequisition[]    @relation("StoreRequisitionRequester")
  supportingDocumentsUploaded SupportingDocument[]  @relation("SupportingDocumentUploader")
  technicalEvaluations        TechnicalEvaluation[] @relation("TechnicalEvaluator")
  materialCards               UserMaterialCard[]    @relation("UserMaterialCardUser")
  roles                       UserRole[]
  departmentRef               Department?           @relation(fields: [departmentId], references: [id])

  @@index([email])
  @@index([isActive])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenVersion String?   @db.VarChar(100)
  userAgent    String?   @db.VarChar(500)
  ipAddress    String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  resource   String?  @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  method     String?  @db.VarChar(10)
  path       String?  @db.VarChar(500)
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Department {
  id                   String                @id @default(uuid()) @db.Uuid
  code                 String                @unique @db.VarChar(30)
  name                 String                @db.VarChar(150)
  description          String?               @db.VarChar(500)
  status               String                @default("Active") @db.VarChar(20)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assetAssignments     AssetAssignment[]
  assets               Asset[]
  issueVouchers        IssueVoucher[]
  purchaseRequisitions PurchaseRequisition[]
  storeRequisitions    StoreRequisition[]
  stores               Store[]
  gatePasses           GatePass[]
  materialCards        UserMaterialCard[]    @relation("UserMaterialCardDepartment")
  users                User[]
  warehouses           Warehouse[]

  @@index([status])
  @@index([name])
  @@map("departments")
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  status      String   @default("Active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]

  @@index([status])
  @@index([name])
  @@map("units")
}

model Store {
  id                   String                @id @default(uuid()) @db.Uuid
  code                 String                @unique @db.VarChar(30)
  name                 String                @db.VarChar(150)
  type                 String                @db.VarChar(30)
  departmentId         String?               @db.Uuid
  location             String?               @db.VarChar(255)
  description          String?               @db.VarChar(500)
  status               String                @default("Active") @db.VarChar(20)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  goodsReceipts        GoodsReceipt[]        @relation("GoodsReceiptStore")
  grns                 GRN[]                 @relation("GRNStore")
  items                Item[]
  locations            Location[]
  purchaseRequisitions PurchaseRequisition[]
  stockTakings         StockTaking[]
  storeIssues          StoreIssue[]
  storeRequisitions    StoreRequisition[]
  departmentRef        Department?           @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([status])
  @@index([name])
  @@map("stores")
}

model Warehouse {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique @db.VarChar(30)
  name          String      @db.VarChar(150)
  type          String      @db.VarChar(30)
  departmentId  String?     @db.Uuid
  location      String?     @db.VarChar(255)
  description   String?     @db.VarChar(500)
  status        String      @default("Active") @db.VarChar(20)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shelves       Shelf[]
  departmentRef Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([status])
  @@index([name])
  @@map("warehouses")
}

model Shelf {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(30)
  name        String     @db.VarChar(150)
  warehouseId String     @db.Uuid
  section     String?    @db.VarChar(50)
  description String?    @db.VarChar(500)
  status      String     @default("Active") @db.VarChar(20)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  locations   Location[]
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@index([status])
  @@map("shelves")
}

model Location {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique @db.VarChar(30)
  storeId               String?                @db.Uuid
  shelfId               String                 @db.Uuid
  section               String?                @db.VarChar(50)
  bin                   String?                @db.VarChar(50)
  description           String?                @db.VarChar(500)
  status                String                 @default("Active") @db.VarChar(20)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assets                Asset[]
  binCards              BinCard[]
  disposalRequests      DisposalRequest[]
  goodsReceiptItems     GoodsReceiptItem[]     @relation("GoodsReceiptItemLocations")
  grnItems              GRNItem[]              @relation("GRNItemLocations")
  inventoryBalances     InventoryBalance[]
  items                 Item[]
  shelf                 Shelf                  @relation(fields: [shelfId], references: [id])
  store                 Store?                 @relation(fields: [storeId], references: [id])
  returnItems           MaterialReturnItem[]
  adjustments           StockAdjustment[]
  stockBatches          StockBatch[]
  stockCards            StockCard[]
  stockCounts           StockCount[]
  discrepancies         StockDiscrepancy[]
  stockTransactions     StockTransaction[]
  destinationTransfers  StockTransfer[]        @relation("TransferDestination")
  sourceTransfers       StockTransfer[]        @relation("TransferSource")
  storeIssueItems       StoreIssueItem[]
  storeRequisitionItems StoreRequisitionItem[]

  @@index([storeId])
  @@index([shelfId])
  @@index([status])
  @@map("locations")
}

model Category {
  id                       String                    @id @default(uuid()) @db.Uuid
  code                     String                    @unique @db.VarChar(30)
  name                     String                    @db.VarChar(150)
  storeType                String?                   @db.VarChar(30)
  description              String?                   @db.VarChar(500)
  status                   String                    @default("Active") @db.VarChar(20)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deliveryItems            DeliveryItem[]
  items                    Item[]
  purchaseOrderItems       PurchaseOrderItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]

  @@index([storeType])
  @@index([status])
  @@index([name])
  @@map("categories")
}

model Item {
  id                       String                    @id @default(uuid()) @db.Uuid
  code                     String                    @unique @db.VarChar(50)
  name                     String                    @db.VarChar(200)
  categoryId               String                    @db.Uuid
  type                     String                    @db.VarChar(50)
  unitId                   String                    @db.Uuid
  storeId                  String                    @db.Uuid
  locationId               String?                   @db.Uuid
  minimum                  Int                       @default(0)
  maximum                  Int                       @default(0)
  reorder                  Int                       @default(0)
  status                   String                    @default("Active") @db.VarChar(20)
  description              String?                   @db.VarChar(500)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  assets                   Asset[]
  binCards                 BinCard[]
  deliveryItems            DeliveryItem[]
  disposalRequests         DisposalRequest[]
  gatePassItems            GatePassItem[]
  goodsReceiptItems        GoodsReceiptItem[]        @relation("GoodsReceiptItems")
  grnItems                 GRNItem[]                 @relation("GRNItems")
  inventoryBalances        InventoryBalance[]
  category                 Category                  @relation(fields: [categoryId], references: [id])
  location                 Location?                 @relation(fields: [locationId], references: [id])
  store                    Store                     @relation(fields: [storeId], references: [id])
  unit                     Unit                      @relation(fields: [unitId], references: [id])
  returnItems              MaterialReturnItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  adjustments              StockAdjustment[]
  stockBatches             StockBatch[]
  stockCards               StockCard[]
  stockCounts              StockCount[]
  discrepancies            StockDiscrepancy[]
  stockTransactions        StockTransaction[]
  stockTransfers           StockTransferItem[]
  storeIssueItems          StoreIssueItem[]
  storeRequisitionItems    StoreRequisitionItem[]

  @@index([categoryId])
  @@index([unitId])
  @@index([storeId])
  @@index([locationId])
  @@index([status])
  @@index([name])
  @@map("items")
}

model Supplier {
  id                   String                @id @default(uuid()) @db.Uuid
  code                 String                @unique @db.VarChar(30)
  name                 String                @db.VarChar(200)
  contact              String?               @db.VarChar(150)
  phone                String?               @db.VarChar(30)
  email                String?               @db.VarChar(255)
  address              String?               @db.VarChar(255)
  description          String?               @db.VarChar(500)
  status               String                @default("Active") @db.VarChar(20)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deliveries           Delivery[]
  goodsReceipts        GoodsReceipt[]        @relation("GoodsReceiptSupplier")
  grns                 GRN[]                 @relation("GRNSupplier")
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]

  @@index([status])
  @@index([name])
  @@map("suppliers")
}

model PurchaseRequisition {
  id              String                    @id @default(uuid()) @db.Uuid
  requestNumber   String                    @unique @db.VarChar(30)
  requesterId     String                    @db.Uuid
  departmentId    String                    @db.Uuid
  storeId         String                    @db.Uuid
  supplierId      String?                   @db.Uuid
  requiredDate    DateTime
  purpose         String                    @db.VarChar(500)
  notes           String?                   @db.VarChar(1000)
  status          ProcurementStatus         @default(DRAFT)
  rejectionReason String?                   @db.VarChar(500)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  approvedById    String?                   @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  purchaseOrders  PurchaseOrder[]
  items           PurchaseRequisitionItem[]
  approvedBy      User?                     @relation("RequisitionApprover", fields: [approvedById], references: [id])
  department      Department                @relation(fields: [departmentId], references: [id])
  requester       User                      @relation("RequisitionRequester", fields: [requesterId], references: [id])
  store           Store                     @relation(fields: [storeId], references: [id])
  supplier        Supplier?                 @relation(fields: [supplierId], references: [id])
  estimatedCost   Decimal?                  @db.Decimal(16, 2)

  @@index([requesterId])
  @@index([departmentId])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@index([requiredDate])
  @@index([createdAt])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                 String              @id @default(uuid()) @db.Uuid
  requisitionId      String              @db.Uuid
  itemId             String              @db.Uuid
  quantity           Decimal             @db.Decimal(14, 2)
  notes              String?             @db.VarChar(500)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  categoryId         String?             @db.Uuid
  purchaseOrderItems PurchaseOrderItem[]
  category           Category?           @relation(fields: [categoryId], references: [id])
  item               Item                @relation(fields: [itemId], references: [id])
  requisition        PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
  @@index([itemId])
  @@map("purchase_requisition_items")
}

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  orderNumber          String              @unique @db.VarChar(30)
  requisitionId        String              @db.Uuid
  supplierId           String              @db.Uuid
  createdById          String              @db.Uuid
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  status               ProcurementStatus   @default(ORDERED)
  subtotal             Decimal             @default(0) @db.Decimal(16, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(16, 2)
  notes                String?             @db.VarChar(1000)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deliveries           Delivery[]
  goodsReceipts        GoodsReceipt[]      @relation("PurchaseOrderGoodsReceipts")
  items                PurchaseOrderItem[]
  createdBy            User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  requisition          PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])

  @@index([requisitionId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String                   @id @default(uuid()) @db.Uuid
  purchaseOrderId   String                   @db.Uuid
  requisitionItemId String?                  @db.Uuid
  itemId            String                   @db.Uuid
  quantity          Decimal                  @db.Decimal(14, 2)
  unitPrice         Decimal                  @db.Decimal(16, 2)
  totalPrice        Decimal                  @db.Decimal(16, 2)
  deliveredQuantity Decimal                  @default(0) @db.Decimal(14, 2)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  categoryId        String?                  @db.Uuid
  deliveryItems     DeliveryItem[]
  category          Category?                @relation(fields: [categoryId], references: [id])
  item              Item                     @relation(fields: [itemId], references: [id])
  purchaseOrder     PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requisitionItem   PurchaseRequisitionItem? @relation(fields: [requisitionItemId], references: [id])

  @@index([purchaseOrderId])
  @@index([requisitionItemId])
  @@index([itemId])
  @@map("purchase_order_items")
}

model Delivery {
  id               String         @id @default(uuid()) @db.Uuid
  deliveryNumber   String         @unique @db.VarChar(30)
  purchaseOrderId  String         @db.Uuid
  supplierId       String         @db.Uuid
  expectedDate     DateTime?
  actualDate       DateTime?
  status           DeliveryStatus @default(IN_TRANSIT)
  notes            String?        @db.VarChar(1000)
  goodsReceivingId String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  items            DeliveryItem[]
  goodsReceipts    GoodsReceipt[] @relation("DeliveryGoodsReceipts")

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([expectedDate])
  @@index([actualDate])
  @@map("deliveries")
}

model DeliveryItem {
  id                  String            @id @default(uuid()) @db.Uuid
  deliveryId          String            @db.Uuid
  purchaseOrderItemId String            @db.Uuid
  itemId              String            @db.Uuid
  quantity            Decimal           @db.Decimal(14, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  categoryId          String?           @db.Uuid
  category            Category?         @relation(fields: [categoryId], references: [id])
  delivery            Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item                Item              @relation(fields: [itemId], references: [id])
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([deliveryId])
  @@index([purchaseOrderItemId])
  @@index([itemId])
  @@map("delivery_items")
}

model GoodsReceipt {
  id                  String               @id @default(uuid()) @db.Uuid
  receiptNumber       String               @unique @db.VarChar(50)
  deliveryId          String?              @db.Uuid
  purchaseOrderId     String?              @db.Uuid
  supplierId          String               @db.Uuid
  storeId             String               @db.Uuid
  sourceType          String               @default("PURCHASE_ORDER") @db.VarChar(30)
  purchaseReference   String?              @db.VarChar(100)
  receiptType         String               @default("Purchase Order") @db.VarChar(50)
  documentReference   String?              @db.VarChar(150)
  deliveryDate        DateTime
  description         String?              @db.VarChar(1000)
  status              String               @default("VERIFICATION_PENDING") @db.VarChar(40)
  receivedById        String               @db.Uuid
  verifiedById        String?              @db.Uuid
  verifiedAt          DateTime?
  evaluationDecision  String?              @db.VarChar(30)
  evaluationRemarks   String?              @db.VarChar(1000)
  inventoryPosted     Boolean              @default(false)
  inventoryPostedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               GoodsReceiptItem[]
  delivery            Delivery?            @relation("DeliveryGoodsReceipts", fields: [deliveryId], references: [id], onDelete: Restrict)
  purchaseOrder       PurchaseOrder?       @relation("PurchaseOrderGoodsReceipts", fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy          User                 @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  store               Store                @relation("GoodsReceiptStore", fields: [storeId], references: [id])
  supplier            Supplier             @relation("GoodsReceiptSupplier", fields: [supplierId], references: [id])
  verifiedBy          User?                @relation("GoodsReceiptVerifiedBy", fields: [verifiedById], references: [id])
  grns                GRN?
  inspections         Inspection[]
  supportingDocuments SupportingDocument[]

  @@index([deliveryId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([storeId])
  @@index([status])
  @@index([deliveryDate])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String           @id @default(uuid()) @db.Uuid
  goodsReceiptId      String           @db.Uuid
  itemId              String           @db.Uuid
  locationId          String?          @db.Uuid
  quantityExpected    Int              @default(0)
  quantityReceived    Int
  acceptedQuantity    Int              @default(0)
  rejectedQuantity    Int              @default(0)
  unit                String           @db.VarChar(50)
  condition           String?          @db.VarChar(100)
  assetClassification String           @default("NON_FIXED") @db.VarChar(30)
  remarks             String?          @db.VarChar(500)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  goodsReceipt        GoodsReceipt     @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  item                Item             @relation("GoodsReceiptItems", fields: [itemId], references: [id])
  location            Location?        @relation("GoodsReceiptItemLocations", fields: [locationId], references: [id])
  grnItems            GRNItem[]
  inspectionItems     InspectionItem[]

  @@index([goodsReceiptId])
  @@index([itemId])
  @@index([locationId])
  @@map("goods_receipt_items")
}

model Inspection {
  id                   String               @id @default(uuid()) @db.Uuid
  goodsReceiptId       String               @db.Uuid
  inspectorId          String               @db.Uuid
  inspectionDate       DateTime             @default(now())
  quantityVerification String               @default("Passed") @db.VarChar(50)
  qualityVerification  String               @default("Passed") @db.VarChar(50)
  status               String               @default("PENDING") @db.VarChar(30)
  decision             String?              @db.VarChar(30)
  remarks              String?              @db.VarChar(1000)
  approvedById         String?              @db.Uuid
  approvedAt           DateTime?
